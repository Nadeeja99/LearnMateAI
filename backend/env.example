# Copy to backend/.env and fill in. Every setting is read by backend/app/config.py
# (field name = lower-cased variable name); anything not listed there is ignored.

ENVIRONMENT=development

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Response token budgets
OPENAI_MAX_TOKENS=500
OPENAI_SUMMARY_MAX_TOKENS=1500
OPENAI_QUIZ_MAX_TOKENS=3500

# LangFuse (optional observability: traces, token usage, cost, time-to-first-token)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Logging: text (readable) or json (one object per line, for log aggregators)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Storage root for per-session indexes and the SQLite database (learnmate.db)
DATA_DIR=data
# Anonymous browser sessions untouched for this many days are deleted on startup (0 disables)
SESSION_TTL_DAYS=30

# CORS
# Development always allows the local dev ports; list extra origins here.
# Production (ENVIRONMENT=production) allows ONLY these origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501

# Abuse & cost limits (a rate limit of 0 disables it)
MAX_UPLOAD_SIZE=20971520
MAX_DOCUMENTS_PER_SESSION=25
MAX_CHUNKS_PER_DOCUMENT=2000
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AI_PER_IP_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_UPLOADS_PER_IP_PER_HOUR=60
# Share rate limits across workers/instances (e.g. redis://host:6379/0). Empty = per process.
REDIS_URL=

# Operational endpoints (/voice/connections, /voice/test). Keep false in production.
ENABLE_DEBUG_ENDPOINTS=false
